# Copy to .env and fill in. Never commit the real .env file.
#
# Local dev: Cloud Functions read these via `firebase functions:config` /
# Secret Manager in deployed environments (see docs/PLAN.md Phase 5), and via
# a gitignored functions/.env for the emulator. Frontend vars (VITE_ prefix)
# are read by Vite from frontend/.env.

# --- LLM (Cloud Functions) ---
ANTHROPIC_API_KEY=

# --- HighLevel OAuth (Cloud Functions) ---
# From your app at marketplace.gohighlevel.com
HL_CLIENT_ID=
HL_CLIENT_SECRET=
# Cloud Function URL registered as the redirect URI in the HL marketplace app
HL_REDIRECT_URI=

# --- Firebase project (used by firebase-tools / CI) ---
FIREBASE_PROJECT_ID=

# --- Frontend (Vite, exposed to the browser — no secrets here) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
