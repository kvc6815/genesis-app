# Copy to .env and fill in. Never commit the real .env file.
#
# Reference only — nothing reads a root .env. Split into:
# - frontend/.env — the VITE_* vars (Vite only reads env files from frontend/)
# - functions/.env — everything else (firebase-functions loads this on deploy
#   and would for the emulator too, but this project's local dev never runs
#   Firebase locally — see README "Running locally")

# --- LLM (Cloud Functions) ---
ANTHROPIC_API_KEY=

# --- HighLevel OAuth (Cloud Functions) ---
# From your app at marketplace.gohighlevel.com
HL_CLIENT_ID=
HL_CLIENT_SECRET=
# Cloud Function URL registered as the redirect URI in the HL marketplace app
HL_REDIRECT_URI=
# Hosting URL the OAuth callback redirects back to after connecting
FRONTEND_URL=

# --- Firebase project (used by firebase-tools / CI) ---
FIREBASE_PROJECT_ID=

# --- Frontend (Vite, exposed to the browser — no secrets here) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Base URL for calling Cloud Functions directly (SSE endpoints, etc.)
VITE_FUNCTIONS_BASE_URL=
# Full HL OAuth install/authorize URL, copied verbatim from the marketplace
# app's dashboard (client_id/redirect_uri/scope are baked in — not secret)
VITE_HL_INSTALL_URL=
